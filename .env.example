# ---- runtime ----
NODE_ENV=development
HOST=127.0.0.1

# ---- express api ----
API_PORT=4000
API_URL=http://localhost:4000
# base url the Next.js app uses to reach the API (server side only)
API_BASE_URL=http://127.0.0.1:4000

# ---- web app ----
NEXT_PUBLIC_APP_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000
UPLOAD_DIR=./uploads

# ---- database (mysql) ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=CHANGE_ME
DB_NAME=kidstoys
# optional override; the db package builds this from the DB_* values above when unset
DATABASE_URL=mysql://root:CHANGE_ME@127.0.0.1:3306/kidstoys

# ---- auth ----
# openssl rand -hex 32
JWT_SECRET=CHANGE_ME
JWT_EXPIRES_IN=7d

# ---- seed admin account ----
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@kidstoys.test
ADMIN_PASSWORD=CHANGE_ME
